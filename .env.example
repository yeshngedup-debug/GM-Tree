# Living Tree (GMC) environment configuration

# Database: set DATABASE_URL for PostgreSQL, or DATABASE_PATH for local SQLite.
# DATABASE_URL="postgresql://..."
# DATABASE_PATH="data/living-tree.sqlite"

# MESSAGE_ENCRYPTION_KEY encrypts visitor private messages.
# Provide a strong random string. If unset, messages fall back to a key derived
# from the per-database session secret.
#
# Ciphertexts are prefixed with a key version ("v1:..."). To rotate:
#   1. Set a new MESSAGE_ENCRYPTION_KEY value.
#   2. Old messages remain decryptable: decryptMessage tries the current key,
#      then the legacy key derived from the session secret.
#   3. Re-encrypt any stored messages with the new key as needed.
# MESSAGE_ENCRYPTION_KEY="..."

# Admin protection
# ADMIN_PASSWORD="..."

# AI (OpenAI-compatible)
# OPENAI_API_KEY="..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="..."
# AI_MODE="online"
# AI_TIMEOUT_MS="15000"

# Rate limits
# AI_RATE_LIMIT="30"
# GLOBAL_RATE_LIMIT="60"
# SUBMISSION_RATE_LIMIT="5"

# Public URL (used for links and metadata)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
